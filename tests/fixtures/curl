#!/usr/bin/env bash
set -euo pipefail

[[ ${RADIO_ATLAS_TEST_CURL_FAIL:-0} != 1 ]] || exit 7

output=""
max_filesize=""
limit=""
request_url=""
while (( $# > 0 )); do
  case "$1" in
    --output)
      output=${2:-}
      shift 2
      ;;
    --max-filesize)
      max_filesize=${2:-}
      shift 2
      ;;
    --data-urlencode)
      if [[ ${2:-} == limit=* ]]; then
        limit=${2#limit=}
      fi
      shift 2
      ;;
    https://*)
      request_url=$1
      shift
      ;;
    *)
      shift
      ;;
  esac
done

[[ $max_filesize == 4194304 ]] || {
  echo 'radio-fetch did not enforce the expected response size limit' >&2
  exit 2
}

payload='[
  {"stationuuid":"bbbbbbbb-1111-1111-1111-bbbbbbbbbbbb","name":"First","url_resolved":"https://example.com/first\n","countrycode":"US","geo_lat":40,"geo_long":-74},
  {"stationuuid":"aaaaaaaa-1111-1111-1111-aaaaaaaaaaaa","name":"Second","url_resolved":"http://example.com/second","countrycode":"CA","geo_lat":43,"geo_long":-79},
  {"stationuuid":"bbbbbbbb-1111-1111-1111-bbbbbbbbbbbb","name":"Duplicate","url_resolved":"https://example.com/duplicate","countrycode":"US","geo_lat":40,"geo_long":-74},
  {"stationuuid":"cccccccc-1111-1111-1111-cccccccccccc","name":"Unsafe","url_resolved":"file:///etc/passwd","countrycode":"US","geo_lat":40,"geo_long":-74},
  {"stationuuid":"dddddddd-1111-1111-1111-dddddddddddd","name":"Invalid coordinates","url_resolved":"https://example.com/invalid","countrycode":"US","geo_lat":140,"geo_long":-74}
]'

if [[ ${RADIO_ATLAS_TEST_CURL_UNKNOWN_LOCATION:-0} == 1 ]]; then
  payload=$(jq -c '. + [{
    stationuuid: "eeeeeeee-1111-1111-1111-eeeeeeeeeeee",
    name: "Unknown location",
    url_resolved: "https://example.com/unknown",
    countrycode: "",
    geo_lat: null,
    geo_long: null
  }]' <<< "$payload")
fi

if [[ $request_url =~ /bycountrycodeexact/([A-Za-z]{2}) ]]; then
  payload=$(jq -c --arg code "${BASH_REMATCH[1]^^}" \
    '[.[] | select((.countrycode // "" | ascii_upcase) == $code)]' <<< "$payload")
fi

if [[ ${RADIO_ATLAS_TEST_CURL_MALFORMED_ONCE:-0} == 1 ]] \
  && mkdir "${RADIO_ATLAS_TEST_CURL_MARKER:?}" 2>/dev/null; then
  payload='{"unexpected":"object"}'
fi

if [[ ${RADIO_ATLAS_TEST_CURL_OVERSIZED:-} == always ]] \
  || { [[ ${RADIO_ATLAS_TEST_CURL_OVERSIZED:-} == once ]] \
    && mkdir "${RADIO_ATLAS_TEST_CURL_OVERSIZED_MARKER:?}" 2>/dev/null; }; then
  [[ -z $output ]] || printf '%s\n' '["partial response"]' > "$output"
  exit 63
fi

if [[ ${RADIO_ATLAS_TEST_CURL_TOO_MANY:-} == always ]] \
  || { [[ ${RADIO_ATLAS_TEST_CURL_TOO_MANY:-} == once ]] \
    && mkdir "${RADIO_ATLAS_TEST_CURL_TOO_MANY_MARKER:?}" 2>/dev/null; }; then
  records=$(( ${limit:-500} + 1 ))
  payload=$(jq -cn --argjson records "$records" '[range(0; $records) | {}]')
fi

if [[ ${RADIO_ATLAS_TEST_CURL_MULTIPLE:-} == always ]] \
  || { [[ ${RADIO_ATLAS_TEST_CURL_MULTIPLE:-} == once ]] \
    && mkdir "${RADIO_ATLAS_TEST_CURL_MULTIPLE_MARKER:?}" 2>/dev/null; }; then
  payload=$'[]\n[]'
fi

if [[ -n $output ]]; then
  printf '%s\n' "$payload" > "$output"
else
  printf '%s\n' "$payload"
fi
