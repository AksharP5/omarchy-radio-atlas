#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

jq -e '
  .schemaVersion == 1
  and .id == "akshar.radio-atlas"
  and (.kinds | index("overlay"))
  and (.kinds | index("bar-widget"))
' "$project_dir/manifest.json" >/dev/null

bash -n "$project_dir/radio-fetch" "$project_dir/radio-player" "$project_dir/radio-state"
luac -p "$project_dir/radio-status.lua"
node "$project_dir/tests/model.test.mjs"
! rg -q 'playerStatusProcess|refreshPlayerStatus' \
  "$project_dir/BarWidget.qml" "$project_dir/RadioAtlas.qml"
! rg -q 'inertia' "$project_dir/Globe.qml"
rg -q 'maximumScale: 24' "$project_dir/Globe.qml"
rg -q 'searchDebounce.restart()' "$project_dir/RadioAtlas.qml"
! rg -q 'enabled: !root.fetching' "$project_dir/RadioAtlas.qml"
! rg -q 'return current.length > 0 ? current : worldStations' "$project_dir/RadioAtlas.qml"
! sed -n '/function playSelected()/,/^  }/p' "$project_dir/RadioAtlas.qml" | rg -q 'recordPlayed'
rg -q 'clockwiseArc' "$project_dir/Globe.qml"
rg -q 'Accessible.onPressAction' "$project_dir/RadioAtlas.qml"
rg -q 'state.loaded === true' "$project_dir/RadioAtlas.qml"
rg -q 'loaded = station_loaded' "$project_dir/radio-status.lua"
rg -q 'pendingVolume' "$project_dir/BarWidget.qml"
rg -q 'playingStationUuid === stationRow.modelData.uuid' "$project_dir/RadioAtlas.qml"
rg -q 'rowMouse.containsMouse' "$project_dir/RadioAtlas.qml"
! rg -q 'selectedIndex === index.*Style.selectedFillFor' "$project_dir/RadioAtlas.qml"
! rg -q 'send_command .*\|\| true' "$project_dir/radio-player"

test_root=$(mktemp -d)
listener_pid=""
cleanup() {
  if [[ -n $listener_pid ]]; then
    kill "$listener_pid" 2>/dev/null || true
    wait "$listener_pid" 2>/dev/null || true
  fi
  rm -rf "$test_root"
}
trap cleanup EXIT
export XDG_RUNTIME_DIR="$test_root/runtime"
export XDG_DATA_HOME="$test_root/data"
runtime_dir="$XDG_RUNTIME_DIR/omarchy-radio-atlas"
mkdir -p "$runtime_dir"

PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" country US \
  > "$test_root/normalized.json"
jq -e '
  length == 2
  and .[0].uuid == "bbbbbbbb-1111-1111-1111-bbbbbbbbbbbb"
  and .[0].name == "First"
  and .[0].url == "https://example.com/first"
  and .[1].uuid == "aaaaaaaa-1111-1111-1111-aaaaaaaaaaaa"
' "$test_root/normalized.json" >/dev/null

PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" search 93 \
  > "$test_root/search.json"
jq -e 'length == 2' "$test_root/search.json" >/dev/null

if RADIO_ATLAS_TEST_CURL_FAIL=1 PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-fetch" search unavailable >/dev/null 2>&1; then
  echo "Failed search was reported as an empty result" >&2
  exit 1
fi

PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" random \
  > "$test_root/random.json"
jq -e '.[0].uuid == "aaaaaaaa-1111-1111-1111-aaaaaaaaaaaa"' \
  "$test_root/random.json" >/dev/null

status=$("$project_dir/radio-player" status)
jq -e '.running == false and .station == {}' <<< "$status" >/dev/null
jq -e '.running == false and .station == {}' "$runtime_dir/status.json" >/dev/null

printf '{"favorites":"bad","recent":null,"volume":"loud"}\n' \
  > "$XDG_DATA_HOME/radio-atlas/state.json"
"$project_dir/radio-state" get \
  | jq -e '.favorites == [] and .recent == [] and .volume == 70' >/dev/null

fixture='[{"uuid":"12345678-1234-1234-1234-123456789abc","name":"Test Radio","url":"https://example.com/radio.mp3","countryCode":"US","latitude":40,"longitude":-74}]'
printf '%s\n' "$fixture" > "$runtime_dir/results.json"
printf '%s\n' "$fixture" > "$runtime_dir/world.json"

"$project_dir/radio-state" played 12345678-1234-1234-1234-123456789abc \
  | jq -e '.recent | length == 1' >/dev/null
"$project_dir/radio-state" favorite 12345678-1234-1234-1234-123456789abc \
  | jq -e '.favorites | length == 1' >/dev/null
"$project_dir/radio-state" favorite 12345678-1234-1234-1234-123456789abc \
  | jq -e '.favorites | length == 0' >/dev/null

for volume in 23 47 81; do
  "$project_dir/radio-player" volume "$volume" \
    | jq -e --argjson volume "$volume" '.running == false and .volume == $volume' >/dev/null
done
"$project_dir/radio-player" volume-up \
  | jq -e '.running == false and .volume == 86' >/dev/null
"$project_dir/radio-player" volume-down \
  | jq -e '.running == false and .volume == 81' >/dev/null
jq -e '.volume == 81' "$XDG_DATA_HOME/radio-atlas/state.json" >/dev/null

/usr/bin/socat UNIX-LISTEN:"$runtime_dir/mpv.sock" EXEC:/usr/bin/cat &
listener_pid=$!
for _ in $(seq 1 50); do
  [[ -S $runtime_dir/mpv.sock ]] && break
  sleep 0.02
done
[[ -S $runtime_dir/mpv.sock ]]

if RADIO_ATLAS_TEST_SOCAT_MODE=error PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-player" toggle >/dev/null 2>&1; then
  echo "Rejected player command was reported as success" >&2
  exit 1
fi

printf '%s\n' '[{"uuid":"existing","name":"Existing","url":"https://example.com/existing"}]' \
  > "$runtime_dir/playlist.json"
if RADIO_ATLAS_TEST_SOCAT_MODE=error PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-player" play 12345678-1234-1234-1234-123456789abc results \
  >/dev/null 2>&1; then
  echo "Rejected playlist was reported as loaded" >&2
  exit 1
fi
jq -e 'length == 1 and .[0].uuid == "existing"' \
  "$runtime_dir/playlist.json" >/dev/null

if RADIO_ATLAS_TEST_SOCAT_MODE=success PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-player" stop >/dev/null 2>&1; then
  echo "Unconfirmed player stop was reported as success" >&2
  exit 1
fi
[[ -S $runtime_dir/mpv.sock ]]
kill "$listener_pid"
wait "$listener_pid" 2>/dev/null || true
listener_pid=""
rm -f "$runtime_dir/mpv.sock"

for _ in $(seq 1 30); do
  printf '{"favorites":[],"recent":[],"volume":70}\n' \
    > "$XDG_DATA_HOME/radio-atlas/state.json"
  "$project_dir/radio-state" favorite 12345678-1234-1234-1234-123456789abc >/dev/null &
  favorite_pid=$!
  "$project_dir/radio-player" volume 43 >/dev/null &
  volume_pid=$!
  wait "$favorite_pid"
  wait "$volume_pid"
  jq -e '.volume == 43 and (.favorites | length == 1)' \
    "$XDG_DATA_HOME/radio-atlas/state.json" >/dev/null
done

if PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-player" play 12345678-1234-1234-1234-123456789abc results \
  >/dev/null 2>&1; then
  echo "Player startup failure was reported as success" >&2
  exit 1
fi

unsafe='[{"uuid":"abcdefab-1234-1234-1234-abcdefabcdef","name":"Unsafe","url":"file:///etc/passwd"}]'
printf '%s\n' "$unsafe" > "$runtime_dir/results.json"
if "$project_dir/radio-player" play abcdefab-1234-1234-1234-abcdefabcdef results \
  >/dev/null 2>&1; then
  echo "Unsafe stream URL was accepted" >&2
  exit 1
fi

echo "All tests passed"
