#!/usr/bin/env python3
"""Download a station favicon to a cache file, refusing non-public hosts.

Usage: radio-favicon URL TARGET [--allow-fake-ip]

Every hop (including redirects, which are followed manually) is resolved and
checked with radio-proxy's public-destination rules, then fetched by curl
pinned to the validated addresses so DNS cannot change between check and use.
"""

import argparse
import importlib.machinery
import importlib.util
import os
import signal
import subprocess
import sys
import tempfile
from pathlib import Path
from urllib.parse import urljoin, urlsplit

sys.dont_write_bytecode = True  # importing radio-proxy must not drop __pycache__ in the plugin
MAX_REDIRECTS = 3
MAX_BYTES = 1_048_576
TIMEOUT_SECONDS = 8

_loader = importlib.machinery.SourceFileLoader(
    "radio_proxy", str(Path(__file__).resolve().parent / "radio-proxy"))
_spec = importlib.util.spec_from_loader(_loader.name, _loader)
radio_proxy = importlib.util.module_from_spec(_spec)
_loader.exec_module(radio_proxy)


class FaviconError(Exception):
    pass


def validated_hop(url, *, allow_fake_ip=False):
    try:
        parts = urlsplit(url)
        host = parts.hostname
        port = parts.port
    except ValueError as error:
        raise FaviconError("invalid URL") from error
    if parts.scheme not in ("http", "https") or not parts.hostname:
        raise FaviconError("unsupported URL")
    if parts.username is not None or parts.password is not None:
        raise FaviconError("credentials in URL")
    try:
        host = host.encode("idna").decode("ascii")
    except UnicodeError as error:
        raise FaviconError("invalid hostname") from error
    if any(character in host for character in "%\\") or any(character.isspace() for character in host):
        raise FaviconError("ambiguous hostname")
    explicit_port = port is not None
    if port is None:
        port = 443 if parts.scheme == "https" else 80
    if not 1 <= port <= 65_535:
        raise FaviconError("bad port")
    try:
        endpoints = radio_proxy.public_endpoints(host, port, allow_fake_ip=allow_fake_ip)
    except radio_proxy.ProxyError as error:
        raise FaviconError("non-public destination") from error
    addresses = [endpoint[3][0] for endpoint in endpoints]
    authority = f"[{host}]" if ":" in host else host
    if explicit_port:
        authority += f":{port}"
    return parts._replace(netloc=authority).geturl(), host, port, addresses


def run_curl(url, host, port, addresses, output):
    pinned = ",".join(f"[{address}]" if ":" in address else address for address in addresses)
    hostname = f"[{host}]" if ":" in host else host
    result = subprocess.run(
        ["setpriv", "--pdeathsig", "TERM", "curl", "-sS", "--globoff", "--proto", "=http,https", "--noproxy", "*",
         "--max-time", str(TIMEOUT_SECONDS), "--max-filesize", str(MAX_BYTES),
         "--resolve", f"{hostname}:{port}:{pinned}",
         "-A", "Mozilla/5.0 RadioAtlas", "-o", output,
         "-w", "%{http_code} %{redirect_url}", "--", url],
        stdin=subprocess.DEVNULL, capture_output=True, text=True,
        timeout=TIMEOUT_SECONDS + 2, check=False)
    if result.returncode != 0:
        raise FaviconError("download failed")
    status, _, location = result.stdout.strip().partition(" ")
    return int(status or 0), location.strip()


def is_image(path):
    result = subprocess.run(["file", "-b", "--mime-type", path],
                            capture_output=True, text=True, check=False)
    return result.stdout.strip().startswith("image/")


def fetch(url, target, curl=run_curl, *, allow_fake_ip=False):
    descriptor, temporary = tempfile.mkstemp(prefix=".favicon.", dir=Path(target).parent)
    os.close(descriptor)
    try:
        for _ in range(MAX_REDIRECTS + 1):
            url, host, port, addresses = validated_hop(url, allow_fake_ip=allow_fake_ip)
            status, location = curl(url, host, port, addresses, temporary)
            if status in (301, 302, 303, 307, 308) and location:
                url = urljoin(url, location)
                continue
            if status != 200:
                raise FaviconError(f"HTTP {status}")
            size = os.path.getsize(temporary) if os.path.exists(temporary) else 0
            if not 0 < size <= MAX_BYTES or not is_image(temporary):
                raise FaviconError("not an image")
            os.replace(temporary, target)
            return
        raise FaviconError("too many redirects")
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("url")
    parser.add_argument("target")
    parser.add_argument("--allow-fake-ip", action="store_true")
    args = parser.parse_args()
    signal.signal(signal.SIGTERM, lambda signum, _: sys.exit(128 + signum))
    os.umask(0o077)
    try:
        os.makedirs(os.path.dirname(args.target), mode=0o700, exist_ok=True)
        if (os.path.isfile(args.target) and 0 < os.path.getsize(args.target) <= MAX_BYTES
                and is_image(args.target)):
            return 0
        fetch(args.url, args.target, allow_fake_ip=args.allow_fake_ip)
    except (FaviconError, OSError, subprocess.SubprocessError) as error:
        print(f"radio-favicon: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
