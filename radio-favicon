#!/usr/bin/env python3
"""Download a station favicon to a cache file, refusing non-public hosts.

Usage: radio-favicon URL TARGET [--allow-fake-ip]

Every hop (including redirects, which are followed manually) is resolved and
checked with radio-proxy's public-destination rules, then fetched by curl
pinned to the validated addresses so DNS cannot change between check and use.
"""

import argparse
import importlib.machinery
import importlib.util
import os
import signal
import struct
import subprocess
import sys
import tempfile
import zlib
from pathlib import Path
from urllib.parse import urljoin, urlsplit

sys.dont_write_bytecode = True  # importing radio-proxy must not drop __pycache__ in the plugin
MAX_REDIRECTS = 3
MAX_BYTES = 1_048_576
MAX_DIMENSION = 1024
TIMEOUT_SECONDS = 8

_loader = importlib.machinery.SourceFileLoader(
    "radio_proxy", str(Path(__file__).resolve().parent / "radio-proxy"))
_spec = importlib.util.spec_from_loader(_loader.name, _loader)
radio_proxy = importlib.util.module_from_spec(_spec)
_loader.exec_module(radio_proxy)


class FaviconError(Exception):
    pass


def validated_hop(url, *, allow_fake_ip=False):
    try:
        parts = urlsplit(url)
        host = parts.hostname
        port = parts.port
    except ValueError as error:
        raise FaviconError("invalid URL") from error
    if parts.scheme not in ("http", "https") or not parts.hostname:
        raise FaviconError("unsupported URL")
    if parts.username is not None or parts.password is not None:
        raise FaviconError("credentials in URL")
    try:
        host = host.encode("idna").decode("ascii")
    except UnicodeError as error:
        raise FaviconError("invalid hostname") from error
    if any(character in host for character in "%\\") or any(character.isspace() for character in host):
        raise FaviconError("ambiguous hostname")
    explicit_port = port is not None
    if port is None:
        port = 443 if parts.scheme == "https" else 80
    if not 1 <= port <= 65_535:
        raise FaviconError("bad port")
    try:
        endpoints = radio_proxy.public_endpoints(host, port, allow_fake_ip=allow_fake_ip)
    except radio_proxy.ProxyError as error:
        raise FaviconError("non-public destination") from error
    addresses = [endpoint[3][0] for endpoint in endpoints]
    authority = f"[{host}]" if ":" in host else host
    if explicit_port:
        authority += f":{port}"
    return parts._replace(netloc=authority).geturl(), host, port, addresses


def run_curl(url, host, port, addresses, output):
    pinned = ",".join(f"[{address}]" if ":" in address else address for address in addresses)
    hostname = f"[{host}]" if ":" in host else host
    result = subprocess.run(
        ["setpriv", "--pdeathsig", "TERM", "curl", "-q", "-sS", "--globoff", "--proto", "=http,https", "--noproxy", "*",
         "--max-time", str(TIMEOUT_SECONDS), "--max-filesize", str(MAX_BYTES),
         "--resolve", f"{hostname}:{port}:{pinned}",
         "-A", "Mozilla/5.0 RadioAtlas", "-o", output,
         "-w", "%{http_code} %{redirect_url}", "--", url],
        stdin=subprocess.DEVNULL, capture_output=True, text=True,
        timeout=TIMEOUT_SECONDS + 2, check=False)
    if result.returncode != 0:
        raise FaviconError("download failed")
    status, _, location = result.stdout.strip().partition(" ")
    return int(status or 0), location.strip()


def png_image(data):
    """Keep one bounded raster, without compressed metadata or animation frames."""
    chunks = [data[:8]]
    offset = 8
    header = False
    pixels = False
    while offset + 12 <= len(data):
        length = int.from_bytes(data[offset:offset + 4], "big")
        kind = data[offset + 4:offset + 8]
        end = offset + 12 + length
        if end > len(data):
            break
        payload = data[offset + 8:end - 4]
        checksum = int.from_bytes(data[end - 4:end], "big")
        if zlib.crc32(kind + payload) != checksum:
            break
        if kind == b"IHDR":
            if header or offset != 8 or length != 13:
                break
            width, height, depth, color, compression, filtering, interlace = struct.unpack(">IIBBBBB", payload)
            depths = {0: (1, 2, 4, 8, 16), 2: (8, 16), 3: (1, 2, 4, 8), 4: (8, 16), 6: (8, 16)}
            if (not 0 < width <= MAX_DIMENSION or not 0 < height <= MAX_DIMENSION
                    or depth not in depths.get(color, ()) or compression or filtering or interlace not in (0, 1)):
                break
            header = True
        elif not header:
            break
        elif kind == b"IDAT":
            pixels = True
        elif kind == b"IEND":
            if length or not pixels or end != len(data):
                break
            return b"".join(chunks) + data[offset:end]
        elif kind == b"PLTE":
            if pixels or not 0 < length <= 768 or length % 3:
                break
        elif kind == b"tRNS":
            if pixels or not 0 < length <= 256:
                break
        elif not kind[0] & 32:
            break
        else:
            # Ancillary chunks can contain compressed profiles/text or APNG frames.
            offset = end
            continue
        chunks.append(data[offset:end])
        offset = end
    raise FaviconError("invalid or oversized PNG")


def jpeg_image(data):
    chunks = [data[:2]]
    offset = 2
    frame = False
    scans = 0
    while offset + 2 <= len(data):
        start = offset
        if data[offset] != 255:
            break
        while offset < len(data) and data[offset] == 255:
            offset += 1
        if offset == len(data):
            break
        marker = data[offset]
        offset += 1
        if marker == 0xD9:
            if not frame or not scans or offset != len(data):
                break
            return b"".join(chunks) + b"\xff\xd9"
        if offset + 2 > len(data):
            break
        length = int.from_bytes(data[offset:offset + 2], "big")
        end = offset + length
        if length < 2 or end > len(data):
            break
        payload = data[offset + 2:end]
        if marker in (0xC0, 0xC1, 0xC2):
            if frame or len(payload) < 6:
                break
            depth, height, width, components = struct.unpack(">BHHB", payload[:6])
            if (depth != 8 or components not in (1, 3, 4) or len(payload) != 6 + 3 * components
                    or not 0 < width <= MAX_DIMENSION or not 0 < height <= MAX_DIMENSION):
                break
            frame = True
        elif marker == 0xDA:
            scans += 1
            if not frame or scans > 64:
                break
            offset = end
            while offset + 1 < len(data):
                if data[offset] == 255:
                    following = offset + 1
                    while following < len(data) and data[following] == 255:
                        following += 1
                    if following == len(data) or data[following] != 0 and not 0xD0 <= data[following] <= 0xD7:
                        break
                    offset = following
                offset += 1
            chunks.append(data[start:offset])
            continue
        elif marker not in (0xC4, 0xDB, 0xDD) and not 0xE0 <= marker <= 0xEF and marker != 0xFE:
            break
        # Keep Adobe's fixed-size color transform marker, but omit EXIF, profiles,
        # thumbnails and comments, which may contain another compressed image.
        if not 0xE0 <= marker <= 0xEF and marker != 0xFE or marker == 0xEE and length == 14:
            chunks.append(data[start:end])
        offset = end
    raise FaviconError("invalid or oversized JPEG")


def image_data(path):
    with open(path, "rb") as source:
        data = source.read(MAX_BYTES + 1)
    if not 0 < len(data) <= MAX_BYTES:
        raise FaviconError("image exceeds the size limit")
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return png_image(data)
    if data.startswith(b"\xff\xd8"):
        return jpeg_image(data)
    raise FaviconError("artwork must be a bounded PNG or JPEG")


def fetch(url, target, curl=run_curl, *, allow_fake_ip=False):
    descriptor, temporary = tempfile.mkstemp(prefix=".favicon.", dir=Path(target).parent)
    os.close(descriptor)
    try:
        for _ in range(MAX_REDIRECTS + 1):
            url, host, port, addresses = validated_hop(url, allow_fake_ip=allow_fake_ip)
            status, location = curl(url, host, port, addresses, temporary)
            if status in (301, 302, 303, 307, 308) and location:
                url = urljoin(url, location)
                continue
            if status != 200:
                raise FaviconError(f"HTTP {status}")
            image = image_data(temporary)
            Path(temporary).write_bytes(image)
            os.replace(temporary, target)
            return
        raise FaviconError("too many redirects")
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("url")
    parser.add_argument("target")
    parser.add_argument("--allow-fake-ip", action="store_true")
    args = parser.parse_args()
    signal.signal(signal.SIGTERM, lambda signum, _: sys.exit(128 + signum))
    os.umask(0o077)
    try:
        os.makedirs(os.path.dirname(args.target), mode=0o700, exist_ok=True)
        if os.path.isfile(args.target):
            try:
                cached = image_data(args.target)
            except FaviconError:
                pass
            else:
                descriptor, temporary = tempfile.mkstemp(prefix=".favicon.", dir=Path(args.target).parent)
                try:
                    with os.fdopen(descriptor, "wb") as output:
                        output.write(cached)
                    os.replace(temporary, args.target)
                finally:
                    if os.path.exists(temporary):
                        os.unlink(temporary)
                return 0
        fetch(args.url, args.target, allow_fake_ip=args.allow_fake_ip)
    except (FaviconError, OSError, subprocess.SubprocessError) as error:
        print(f"radio-favicon: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
