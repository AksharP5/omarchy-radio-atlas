#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

jq -e '
  .schemaVersion == 1
  and .id == "akshar.radio-atlas"
  and .version == "0.1.4"
  and (.kinds | index("overlay"))
  and (.kinds | index("bar-widget"))
  and .keepLoaded == true
' "$project_dir/manifest.json" >/dev/null

bash -n "$project_dir/radio-fetch" "$project_dir/radio-player" \
  "$project_dir/radio-sandbox" "$project_dir/radio-session" "$project_dir/radio-state" \
  "$project_dir/tests/fixtures/"*
luac -p "$project_dir/radio-status.lua"
node "$project_dir/tests/model.test.mjs"
python3 "$project_dir/tests/proxy.test.py"
! rg -q 'playerStatusProcess|refreshPlayerStatus' \
  "$project_dir/BarWidget.qml" "$project_dir/RadioAtlas.qml"
! rg -q 'inertia' "$project_dir/Globe.qml"
rg -q 'maximumScale: 24' "$project_dir/Globe.qml"
rg -q 'searchDebounce.restart()' "$project_dir/RadioAtlas.qml"
rg -q 'worldStationLimit: 5000' "$project_dir/RadioAtlas.qml"
rg -q 'id: worldExpandTimer' "$project_dir/RadioAtlas.qml"
rg -q 'id: worldExpandProcess' "$project_dir/RadioAtlas.qml"
! rg -q 'enabled: !root.fetching' "$project_dir/RadioAtlas.qml"
rg -Fq 'mergeGeoStations(worldStations, displayStations, countries)' "$project_dir/RadioAtlas.qml"
rg -Fq 'if (mode === "world") return "world"' "$project_dir/RadioAtlas.qml"
sed -n '/function activateMapStation/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -q 'worldStations'
sed -n '/function activateMapStation/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'showWorld(false)'
sed -n '/function search(text)/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'previewSearch(query)'
sed -n '/function browseCountry/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'RadioModel.stationsForCountry(worldStations, countryCode)'
sed -n '/function browseCountry/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'RadioModel.prioritizeStations('
sed -n '/function tuneRandom/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'startFetch("random", randomExclusions())'
sed -n '/function open(payloadJson)/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -q 'showWorld\(\).*tuneRandom\(\)' -U --multiline-dotall
sed -n '/function open(payloadJson)/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'scheduleWorldExpansion(800)'
sed -n '/function randomExclusions/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'append(playingStationUuid)'
sed -n '/function randomExclusions/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'append(lastRandomUuid)'
sed -n '/function randomExclusions/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'i < recent.length'
world_update_line=$(rg -n 'root.worldStations = RadioModel.mergeStations' "$project_dir/RadioAtlas.qml" \
  | cut -d: -f1)
pending_fetch_line=$(rg -n 'if \(root.pendingFetchAction\)' "$project_dir/RadioAtlas.qml" \
  | cut -d: -f1)
(( world_update_line < pending_fetch_line ))
sed -n '/if (root.fetchAction === "world") {/,/^      }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'root.setStationList("world", root.worldStations)'
country_fetch_block=$(sed -n \
  '/root.fetchAction === "country"/,/root.fetchAction === "search"/p' \
  "$project_dir/RadioAtlas.qml")
rg -Fq 'RadioModel.mergeStations(root.results, stations, 500)' \
  <<<"$country_fetch_block"
rg -Fq 'RadioModel.prioritizeStations(' <<<"$country_fetch_block"
rg -Fq 'root.setStationList("country", countryStations)' <<<"$country_fetch_block"
sed -n '/if (root.pendingFetchAction)/,/^        }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'nextAction === "random" ? root.randomExclusions() : nextValue'
! sed -n '/function playSelected()/,/^  }/p' "$project_dir/RadioAtlas.qml" | rg -q 'recordPlayed'
rg -q 'clockwiseArc' "$project_dir/Globe.qml"
rg -q 'Accessible.onPressAction' "$project_dir/RadioAtlas.qml"
rg -q 'state.loaded === true' "$project_dir/RadioAtlas.qml"
rg -q 'loaded = station_loaded' "$project_dir/radio-status.lua"
rg -q 'pendingVolume' "$project_dir/BarWidget.qml"
rg -q 'playingStationUuid === stationRow.modelData.uuid' "$project_dir/RadioAtlas.qml"
rg -q 'readonly property string playingStationName' "$project_dir/RadioAtlas.qml"
rg -q 'readonly property string playingTrackTitle' "$project_dir/RadioAtlas.qml"
sed -n '/id: playerPanel/,/^          }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'root.playingStationName || root.playerTitle || "Unknown station"'
sed -n '/id: playingFavoriteButton/,/^            }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'root.toggleFavorite(root.playingStationUuid)'
rg -q 'property color favoriteColor: lightTheme' "$project_dir/RadioAtlas.qml"
[[ $(rg -c '\? root\.favoriteColor : root\.foreground' "$project_dir/RadioAtlas.qml") == 2 ]]
! rg -q 'active: root\.isFavorite' "$project_dir/RadioAtlas.qml"
! rg -Fq 'color: root.fetching ? root.dim' "$project_dir/RadioAtlas.qml"
rg -Fq 'click another country to browse' "$project_dir/RadioAtlas.qml"
sed -n '/id: mapHint/,/^          }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'anchors.right: signalCount.left'
sed -n '/id: mapHint/,/^          }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'elide: Text.ElideRight'
rg -q 'rowMouse.containsMouse' "$project_dir/RadioAtlas.qml"
! rg -q 'selectedIndex === index.*Style.selectedFillFor' "$project_dir/RadioAtlas.qml"
! rg -q 'send_command .*\|\| true' "$project_dir/radio-player"
rg -q 'maximumLength: 128' "$project_dir/RadioAtlas.qml"
rg -Fq 'Math.min(1.5, Math.max(0.7, globeRadius / 500))' "$project_dir/Globe.qml"
rg -Fq 'estimatedLocation === true' "$project_dir/Globe.qml"
sed -n '/function paintGlobe/,/^  }/p' "$project_dir/Globe.qml" \
  | rg -Fq 'if (!isFinite(globeRadius) || globeRadius <= 0) return'
rg -q 'WlrLayershell.keyboardFocus: root.opened' "$project_dir/RadioAtlas.qml"
rg -q '^import Quickshell.Hyprland$' "$project_dir/RadioAtlas.qml"
sed -n '/function handleHyprlandEvent/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'event.parse(4)'
sed -n '/function handleHyprlandEvent/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'org.omarchy.screensaver'
sed -n '/function handleHyprlandEvent/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'dismiss()'
rg -q 'keyboardSelectionVisible' "$project_dir/RadioAtlas.qml"
rg -q 'reportedVolume' "$project_dir/RadioAtlas.qml"
rg -q 'submittedVolume' "$project_dir/RadioAtlas.qml"
rg -q 'playPreparing' "$project_dir/RadioAtlas.qml"
rg -q 'id: stopProcess' "$project_dir/RadioAtlas.qml"
! rg -q 'playerAction\("stop"\)' "$project_dir/RadioAtlas.qml"
rg -Fq 'safeTooltipText(root.playerTitle)' "$project_dir/BarWidget.qml"
for qml in "$project_dir/RadioAtlas.qml" "$project_dir/Globe.qml"; do
  [[ $(rg -c '^\s*Text \{' "$qml") == $(rg -c 'textFormat: Text\.PlainText' "$qml") ]]
done
! rg -q '/tmp/omarchy-radio-atlas' \
  "$project_dir/radio-fetch" "$project_dir/radio-player" "$project_dir/radio-state"
rg -q '^max_response_bytes=4194304$' "$project_dir/radio-fetch"
rg -q '^world_cache_minutes=1440$' "$project_dir/radio-fetch"
rg -q '^country_cache_minutes=1440$' "$project_dir/radio-fetch"
rg -Fq 'world_cache_file="$cache_dir/world.json"' "$project_dir/radio-fetch"
rg -q '^refresh_world_cache_in_background\(\)' "$project_dir/radio-fetch"
rg -q '^refresh_country_cache_in_background\(\)' "$project_dir/radio-fetch"
rg -Fq -- '--max-filesize "$max_response_bytes"' "$project_dir/radio-fetch"
rg -q -- "--proto '=https'" "$project_dir/radio-fetch"
rg -Fq 'setpriv --pdeathsig TERM curl' "$project_dir/radio-fetch"
! rg -q -- '--location' "$project_dir/radio-fetch"
rg -Fq -- '--retry 1 --retry-delay 0' "$project_dir/radio-fetch"
rg -Fq '.[:500]' "$project_dir/radio-fetch"
! sed -n '/  random)/,/^    ;;/p' "$project_dir/radio-fetch" \
  | rg -Fq 'has_geo_info=true'
rg -q 'pendingPlayStation' "$project_dir/RadioAtlas.qml"
rg -q 'playPendingStation' "$project_dir/RadioAtlas.qml"
rg -q 'pendingPlayStations' "$project_dir/RadioAtlas.qml"
! sed -n '/function setStationList/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -q 'cancelPendingPlay'
sed -n '/function playPendingStation/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'playStation(station, scope, stations)'
sed -n '/function playStation/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'writeSelection(playSelectionFile, station, stations)'
sed -n '/function writeSelection/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'RadioModel.stationWindow(stations, station && station.uuid, 500)'
sed -n '/id: playSelectionFile/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'preload: false'
sed -n '/id: playSelectionFile/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'blockWrites: true'
sed -n '/id: favoriteSelectionFile/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'preload: false'
sed -n '/id: favoriteSelectionFile/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'blockWrites: true'
rg -Fq 'selection_file="$runtime_dir/play-selection.json"' "$project_dir/radio-player"
rg -q 'pendingFavoriteRequests' "$project_dir/RadioAtlas.qml"
! sed -n '/function toggleFavorite/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -q 'favoriteSelectionFile\.setText'
sed -n '/function startFavorite/,/^  }/p' "$project_dir/RadioAtlas.qml" \
  | rg -Fq 'favoriteSelectionFile.setText(JSON.stringify(request.rows)'
rg -Fq 'favorite-selection.json' "$project_dir/radio-state"
rg -q 'statusReady' "$project_dir/RadioAtlas.qml" "$project_dir/BarWidget.qml"
rg -Fq -- '--demuxer-max-bytes=8MiB' "$project_dir/radio-player"
rg -Fq 'max-children=32' "$project_dir/radio-sandbox"
rg -q 'MAX_ACTIVE_CONNECTIONS = 32' "$project_dir/radio-proxy"
rg -Fq 'setpriv --pdeathsig TERM socat TCP4-LISTEN:18765' \
  "$project_dir/radio-sandbox"
rg -Fq 'bwrap --unshare-net --unshare-pid --die-with-parent' \
  "$project_dir/radio-session"

test_root=$(mktemp -d)
listener_pid=""
lock_holder_pid=""
locked_status_pid=""
session_pid=""
preparing_pid=""
cleanup() {
  local exit_code=$?
  if (( exit_code != 0 )); then
    for log in "$test_root/session.log" "$test_root/preparing-player.err" \
      "$runtime_dir/mpv.log" "$runtime_dir/proxy.log"; do
      if [[ -s $log ]]; then
        printf '\n%s:\n' "$log" >&2
        sed -n '1,160p' "$log" >&2
      fi
    done
  fi
  if [[ -n $listener_pid ]]; then
    kill "$listener_pid" 2>/dev/null || true
    wait "$listener_pid" 2>/dev/null || true
  fi
  if [[ -n $locked_status_pid ]]; then
    kill "$locked_status_pid" 2>/dev/null || true
    wait "$locked_status_pid" 2>/dev/null || true
  fi
  if [[ -n $lock_holder_pid ]]; then
    kill "$lock_holder_pid" 2>/dev/null || true
    wait "$lock_holder_pid" 2>/dev/null || true
  fi
  if [[ -n $session_pid ]]; then
    kill -KILL -- "-$session_pid" 2>/dev/null || true
    wait "$session_pid" 2>/dev/null || true
  fi
  if [[ -n $preparing_pid ]]; then
    kill -KILL -- "-$preparing_pid" 2>/dev/null || true
    wait "$preparing_pid" 2>/dev/null || true
  fi
  rm -rf "$test_root"
  exit "$exit_code"
}
trap cleanup EXIT
export XDG_RUNTIME_DIR="$test_root/runtime"
export XDG_DATA_HOME="$test_root/data"
export XDG_CACHE_HOME="$test_root/cache"
runtime_dir="$XDG_RUNTIME_DIR/omarchy-radio-atlas"
cache_dir="$XDG_CACHE_HOME/omarchy-radio-atlas"
mkdir -p "$runtime_dir"

track_player_pid() {
  local pid=$1
  printf '%s %s\n' "$pid" "$(awk '{ print $22 }' "/proc/$pid/stat")" \
    > "$runtime_dir/player.pid"
}

if env -u XDG_RUNTIME_DIR "$project_dir/radio-state" get >/dev/null 2>&1; then
  echo "Missing XDG_RUNTIME_DIR was accepted" >&2
  exit 1
fi

PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" country US \
  > "$test_root/normalized.json"
jq -e '
  length == 1
  and .[0].uuid == "bbbbbbbb-1111-1111-1111-bbbbbbbbbbbb"
  and .[0].name == "First"
  and .[0].url == "https://example.com/first"
' "$test_root/normalized.json" >/dev/null
[[ $(stat -c '%a' "$runtime_dir") == 700 ]]
[[ $(stat -c '%a' "$cache_dir") == 700 ]]
[[ $(stat -c '%a' "$cache_dir/countries") == 700 ]]
jq -e 'length == 1' "$cache_dir/countries/US.json" >/dev/null

PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" world-more \
  > "$test_root/world-more.json"
jq -e 'length == 2' "$test_root/world-more.json" >/dev/null

stale_country='[{"uuid":"eeeeeeee-1111-1111-1111-eeeeeeeeeeee","name":"Old country cache","url":"https://example.com/old","countryCode":"US","latitude":40,"longitude":-74}]'
printf '%s\n' "$stale_country" > "$cache_dir/countries/US.json"
touch -d '2 days ago' "$cache_dir/countries/US.json"
PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" country US \
  > "$test_root/stale-country.json"
jq -e 'length == 1 and .[0].name == "Old country cache"' \
  "$test_root/stale-country.json" >/dev/null
for _ in $(seq 1 100); do
  jq -e 'length == 1 and .[0].name == "First"' \
    "$cache_dir/countries/US.json" >/dev/null 2>&1 && break
  sleep 0.01
done
jq -e 'length == 1 and .[0].name == "First"' \
  "$cache_dir/countries/US.json" >/dev/null
jq -e 'length == 1 and .[0].name == "Old country cache"' \
  "$runtime_dir/results.json" >/dev/null

RADIO_ATLAS_TEST_CURL_FAIL=1 PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-fetch" country US > "$test_root/cached-country.json"
jq -e 'length == 1' "$test_root/cached-country.json" >/dev/null

legacy_world='[{"uuid":"cccccccc-1111-1111-1111-cccccccccccc","name":"Cached","url":"https://example.com/cached","country":"Canada","countryCode":"CA","latitude":43,"longitude":-79}]'
printf '%s\n' "$legacy_world" > "$runtime_dir/world.json"
RADIO_ATLAS_TEST_CURL_FAIL=1 PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-fetch" world > "$test_root/imported-world.json"
jq -e 'length == 1 and .[0].name == "Cached"' "$test_root/imported-world.json" >/dev/null
cmp "$test_root/imported-world.json" "$cache_dir/world.json"

rm -f "$runtime_dir/world.json"
truncate -s 4194305 "$cache_dir/world.json"
PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" world \
  > "$test_root/world-after-oversized-cache.json"
jq -e 'length == 2' "$test_root/world-after-oversized-cache.json" >/dev/null

jq -cn '[range(0; 501) | {}]' > "$cache_dir/world.json"
PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" world \
  > "$test_root/world-after-excessive-cache.json"
jq -e 'length == 2' "$test_root/world-after-excessive-cache.json" >/dev/null

printf '%s\n' "$legacy_world" > "$cache_dir/world.json"
touch -d '2 days ago' "$cache_dir/world.json"
PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" world \
  > "$test_root/stale-world.json"
jq -e 'length == 1 and .[0].name == "Cached"' "$test_root/stale-world.json" >/dev/null
jq -e 'length == 1 and .[0].name == "Cached"' "$runtime_dir/results.json" >/dev/null
for _ in $(seq 1 100); do
  jq -e 'length == 2' "$cache_dir/world.json" >/dev/null 2>&1 && break
  sleep 0.01
done
jq -e 'length == 2' "$cache_dir/world.json" >/dev/null
jq -e 'length == 1 and .[0].name == "Cached"' "$runtime_dir/results.json" >/dev/null

printf '%s\n' "$legacy_world" > "$cache_dir/world.json"
rm -f "$cache_dir/countries/CA.json"
RADIO_ATLAS_TEST_CURL_FAIL=1 PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-fetch" country CA > "$test_root/world-country.json"
jq -e 'length == 1 and .[0].name == "Cached"' "$test_root/world-country.json" >/dev/null

malformed_marker="$test_root/malformed-response"
rm -f "$cache_dir/countries/US.json"
RADIO_ATLAS_TEST_CURL_MALFORMED_ONCE=1 \
RADIO_ATLAS_TEST_CURL_MARKER="$malformed_marker" \
PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-fetch" country US > "$test_root/fallback.json"
jq -e 'length == 1' "$test_root/fallback.json" >/dev/null

oversized_marker="$test_root/oversized-response"
rm -f "$cache_dir/countries/US.json"
RADIO_ATLAS_TEST_CURL_OVERSIZED=once \
RADIO_ATLAS_TEST_CURL_OVERSIZED_MARKER="$oversized_marker" \
PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-fetch" country US > "$test_root/oversized-fallback.json"
jq -e 'length == 1' "$test_root/oversized-fallback.json" >/dev/null
cp "$runtime_dir/results.json" "$test_root/results-before-failure.json"
rm -f "$cache_dir/countries/US.json"
if RADIO_ATLAS_TEST_CURL_OVERSIZED=always PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-fetch" country US >/dev/null 2>&1; then
  echo "Oversized responses were accepted" >&2
  exit 1
fi
cmp "$test_root/results-before-failure.json" "$runtime_dir/results.json"

too_many_marker="$test_root/too-many-response"
rm -f "$cache_dir/countries/US.json"
RADIO_ATLAS_TEST_CURL_TOO_MANY=once \
RADIO_ATLAS_TEST_CURL_TOO_MANY_MARKER="$too_many_marker" \
PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-fetch" country US > "$test_root/too-many-fallback.json"
jq -e 'length == 1' "$test_root/too-many-fallback.json" >/dev/null
cp "$runtime_dir/results.json" "$test_root/results-before-cardinality-failure.json"
rm -f "$cache_dir/countries/US.json"
if RADIO_ATLAS_TEST_CURL_TOO_MANY=always PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-fetch" country US >/dev/null 2>&1; then
  echo "Responses with excessive record counts were accepted" >&2
  exit 1
fi
cmp "$test_root/results-before-cardinality-failure.json" "$runtime_dir/results.json"

multiple_marker="$test_root/multiple-response"
rm -f "$cache_dir/countries/US.json"
RADIO_ATLAS_TEST_CURL_MULTIPLE=once \
RADIO_ATLAS_TEST_CURL_MULTIPLE_MARKER="$multiple_marker" \
PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-fetch" country US > "$test_root/multiple-fallback.json"
jq -e 'length == 1' "$test_root/multiple-fallback.json" >/dev/null
rm -f "$cache_dir/countries/US.json"
if RADIO_ATLAS_TEST_CURL_MULTIPLE=always PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-fetch" country US >/dev/null 2>&1; then
  echo "Multiple JSON documents were accepted as one response" >&2
  exit 1
fi

PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" search 93 \
  > "$test_root/search.json"
jq -e 'length == 2' "$test_root/search.json" >/dev/null

if RADIO_ATLAS_TEST_CURL_FAIL=1 PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-fetch" search unavailable >/dev/null 2>&1; then
  echo "Failed search was reported as an empty result" >&2
  exit 1
fi

RADIO_ATLAS_TEST_CURL_UNKNOWN_LOCATION=1 \
PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" random \
  > "$test_root/random.json"
jq -e 'length == 2
  and .[0].uuid == "aaaaaaaa-1111-1111-1111-aaaaaaaaaaaa"
  and all(.[];
    ((.latitude != null and .longitude != null)
      or (.countryCode | test("^[A-Z]{2}$"))))' \
  "$test_root/random.json" >/dev/null
printf '%s\n' \
  '{"favorites":[],"recent":[{"uuid":"aaaaaaaa-1111-1111-1111-aaaaaaaaaaaa"}],"volume":70}' \
  > "$XDG_DATA_HOME/radio-atlas/state.json"
PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" random \
  > "$test_root/random-with-saved-history.json"
jq -e 'length == 1 and .[0].uuid == "bbbbbbbb-1111-1111-1111-bbbbbbbbbbbb"' \
  "$test_root/random-with-saved-history.json" >/dev/null
printf '%s\n' '{"favorites":[],"recent":[],"volume":70}' \
  > "$XDG_DATA_HOME/radio-atlas/state.json"
PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" random \
  aaaaaaaa-1111-1111-1111-aaaaaaaaaaaa > "$test_root/random-with-exclusion.json"
jq -e 'length == 1 and .[0].uuid == "bbbbbbbb-1111-1111-1111-bbbbbbbbbbbb"' \
  "$test_root/random-with-exclusion.json" >/dev/null
PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" random \
  aaaaaaaa-1111-1111-1111-aaaaaaaaaaaa,bbbbbbbb-1111-1111-1111-bbbbbbbbbbbb \
  > "$test_root/random-all-excluded.json"
jq -e 'length == 2' "$test_root/random-all-excluded.json" >/dev/null
if PATH="$project_dir/tests/fixtures:$PATH" "$project_dir/radio-fetch" random invalid \
  >/dev/null 2>&1; then
  echo "Invalid random exclusions were accepted" >&2
  exit 1
fi

status=$("$project_dir/radio-player" status)
jq -e '.running == false and .station == {}' <<< "$status" >/dev/null
jq -e '.running == false and .station == {}' "$runtime_dir/status.json" >/dev/null

lock_ready="$test_root/player-lock-ready"
lock_release="$test_root/player-lock-release"
(
  exec 7>"$runtime_dir/player.lock"
  flock -x 7
  : > "$lock_ready"
  while [[ ! -e $lock_release ]]; do
    sleep 0.01
  done
) &
lock_holder_pid=$!
for _ in $(seq 1 100); do
  [[ -e $lock_ready ]] && break
  sleep 0.01
done
[[ -e $lock_ready ]]
"$project_dir/radio-player" status > "$test_root/locked-status.json" &
locked_status_pid=$!
sleep 0.05
kill -0 "$locked_status_pid"
: > "$lock_release"
wait "$lock_holder_pid"
lock_holder_pid=""
wait "$locked_status_pid"
locked_status_pid=""
jq -e '.running == false' "$test_root/locked-status.json" >/dev/null

printf '{"favorites":"bad","recent":null,"volume":"loud"}\n' \
  > "$XDG_DATA_HOME/radio-atlas/state.json"
cp "$XDG_DATA_HOME/radio-atlas/state.json" "$test_root/invalid-state.json"
if "$project_dir/radio-state" get >/dev/null 2>&1; then
  echo "Invalid saved state was silently accepted" >&2
  exit 1
fi
cmp "$test_root/invalid-state.json" "$XDG_DATA_HOME/radio-atlas/state.json"
if "$project_dir/radio-player" volume 42 >/dev/null 2>&1; then
  echo "Volume update overwrote invalid saved state" >&2
  exit 1
fi
cmp "$test_root/invalid-state.json" "$XDG_DATA_HOME/radio-atlas/state.json"
rm "$XDG_DATA_HOME/radio-atlas/state.json"

truncate -s 4194305 "$XDG_DATA_HOME/radio-atlas/state.json"
if timeout 2 "$project_dir/radio-state" get >/dev/null 2>&1; then
  echo "Oversized saved state was accepted" >&2
  exit 1
fi
[[ $(stat -c '%s' "$XDG_DATA_HOME/radio-atlas/state.json") == 4194305 ]]
rm "$XDG_DATA_HOME/radio-atlas/state.json"

jq -cn '{favorites: [range(0; 501) | {uuid: tostring}], recent: [], volume: 70}' \
  > "$XDG_DATA_HOME/radio-atlas/state.json"
if "$project_dir/radio-state" get >/dev/null 2>&1; then
  echo "Saved state with too many favorites was accepted" >&2
  exit 1
fi
rm "$XDG_DATA_HOME/radio-atlas/state.json"

printf '%s\n%s\n' \
  '{"favorites":[],"recent":[],"volume":70}' \
  '{"favorites":[],"recent":[],"volume":70}' \
  > "$XDG_DATA_HOME/radio-atlas/state.json"
if "$project_dir/radio-state" get >/dev/null 2>&1; then
  echo "Multiple saved-state documents were accepted as one" >&2
  exit 1
fi
rm "$XDG_DATA_HOME/radio-atlas/state.json"

"$project_dir/radio-state" get \
  | jq -e '.favorites == [] and .recent == [] and .volume == 70' >/dev/null

fixture='[{"uuid":"12345678-1234-1234-1234-123456789abc","name":"Test Radio","url":"https://example.com/radio.mp3","countryCode":"US","latitude":40,"longitude":-74}]'
printf '%s\n' "$fixture" > "$runtime_dir/results.json"
printf '%s\n' "$fixture" > "$runtime_dir/world.json"

truncate -s 4194305 "$runtime_dir/playlist.json"
"$project_dir/radio-state" played 12345678-1234-1234-1234-123456789abc \
  | jq -e '.recent | length == 1' >/dev/null
jq -e 'length == 0' "$runtime_dir/playlist.json" >/dev/null

"$project_dir/radio-state" played 12345678-1234-1234-1234-123456789abc \
  | jq -e '.recent | length == 1' >/dev/null
"$project_dir/radio-state" favorite 12345678-1234-1234-1234-123456789abc \
  | jq -e '.favorites | length == 1' >/dev/null
"$project_dir/radio-state" favorite 12345678-1234-1234-1234-123456789abc \
  | jq -e '.favorites | length == 0' >/dev/null

selection_only='[{"uuid":"fedcbafe-1234-1234-1234-fedcbafedcba","name":"Selection only","url":"https://example.com/selection.mp3","countryCode":"CA","latitude":43,"longitude":-79}]'
printf '%s\n' "$selection_only" > "$runtime_dir/favorite-selection.json"
"$project_dir/radio-state" favorite fedcbafe-1234-1234-1234-fedcbafedcba \
  | jq -e '.favorites[0].uuid == "fedcbafe-1234-1234-1234-fedcbafedcba"' >/dev/null
"$project_dir/radio-state" favorite fedcbafe-1234-1234-1234-fedcbafedcba \
  | jq -e '.favorites | length == 0' >/dev/null

queue_fixture='[{"uuid":"87654321-4321-4321-4321-cba987654321","name":"Queued Radio","url":"https://example.com/queued.mp3","countryCode":"CA","latitude":43,"longitude":-79}]'
printf '%s\n' "$queue_fixture" > "$runtime_dir/playlist.json"
"$project_dir/radio-state" played 87654321-4321-4321-4321-cba987654321 \
  | jq -e '.recent[0].uuid == "87654321-4321-4321-4321-cba987654321"' >/dev/null

for volume in 23 47 81; do
  "$project_dir/radio-player" volume "$volume" \
    | jq -e --argjson volume "$volume" '.running == false and .volume == $volume' >/dev/null
done
"$project_dir/radio-player" volume-up \
  | jq -e '.running == false and .volume == 86' >/dev/null
"$project_dir/radio-player" volume-down \
  | jq -e '.running == false and .volume == 81' >/dev/null
jq -e '.volume == 81' "$XDG_DATA_HOME/radio-atlas/state.json" >/dev/null

fetch_ready="$test_root/fetch-ready"
fetch_release="$test_root/fetch-release"
mpv_marker="$test_root/canceled-mpv-started"
setsid env \
  RADIO_ATLAS_FETCH_PATH="$project_dir/tests/fixtures/radio-fetch" \
  RADIO_ATLAS_TEST_FETCH_READY="$fetch_ready" \
  RADIO_ATLAS_TEST_FETCH_RELEASE="$fetch_release" \
  RADIO_ATLAS_TEST_MPV_MARKER="$mpv_marker" \
  PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-player" play 12345678-1234-1234-1234-123456789abc recent \
  > "$test_root/preparing-player.out" 2> "$test_root/preparing-player.err" &
preparing_pid=$!
for _ in $(seq 1 100); do
  [[ -e $fetch_ready ]] && break
  sleep 0.01
done
[[ -e $fetch_ready ]]
timeout 1 "$project_dir/radio-player" status >/dev/null
timeout 1 "$project_dir/radio-player" stop >/dev/null
: > "$fetch_release"
if wait "$preparing_pid"; then
  echo "Canceled playback preparation was started" >&2
  exit 1
fi
preparing_pid=""
[[ ! -e $mpv_marker ]]

/usr/bin/socat UNIX-LISTEN:"$runtime_dir/mpv.sock" EXEC:/usr/bin/cat &
listener_pid=$!
track_player_pid "$listener_pid"
for _ in $(seq 1 50); do
  [[ -S $runtime_dir/mpv.sock ]] && break
  sleep 0.02
done
[[ -S $runtime_dir/mpv.sock ]]

if RADIO_ATLAS_TEST_SOCAT_MODE=error PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-player" toggle >/dev/null 2>&1; then
  echo "Rejected player command was reported as success" >&2
  exit 1
fi

printf '%s\n' '[{"uuid":"existing","name":"Existing","url":"https://example.com/existing"}]' \
  > "$runtime_dir/playlist.json"
if RADIO_ATLAS_TEST_SOCAT_MODE=error PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-player" play 12345678-1234-1234-1234-123456789abc results \
  >/dev/null 2>&1; then
  echo "Rejected playlist was reported as loaded" >&2
  exit 1
fi
jq -e 'length == 1 and .[0].uuid == "existing"' \
  "$runtime_dir/playlist.json" >/dev/null

selection_fixture='[
  {"uuid":"11111111-1234-1234-1234-111111111111","name":"Before","url":"https://example.com/before.mp3","countryCode":"CA","latitude":43,"longitude":-79},
  {"uuid":"abcdefab-1234-1234-1234-abcdefabcdef","name":"Selected Radio","url":"https://example.com/selected.mp3","countryCode":"CA","latitude":43,"longitude":-79},
  {"uuid":"22222222-1234-1234-1234-222222222222","name":"After","url":"https://example.com/after.mp3","countryCode":"CA","latitude":43,"longitude":-79}
]'
printf '%s\n' "$selection_fixture" > "$runtime_dir/play-selection.json"
RADIO_ATLAS_TEST_SOCAT_MODE=success PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-player" play abcdefab-1234-1234-1234-abcdefabcdef selection \
  >/dev/null
jq -e 'length == 3
  and .[0].uuid == "abcdefab-1234-1234-1234-abcdefabcdef"
  and .[1].uuid == "22222222-1234-1234-1234-222222222222"
  and .[2].uuid == "11111111-1234-1234-1234-111111111111"' \
  "$runtime_dir/playlist.json" >/dev/null

RADIO_ATLAS_TEST_SOCAT_MODE=success PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-player" stop \
  | jq -e '.running == false' >/dev/null
wait "$listener_pid" 2>/dev/null || true
listener_pid=""
[[ ! -S $runtime_dir/mpv.sock ]]
"$project_dir/radio-player" status >/dev/null
[[ ! -e $runtime_dir/player.pid ]]

python3 - "$runtime_dir/mpv.sock" <<'PY'
import socket
import sys

server = socket.socket(socket.AF_UNIX)
server.bind(sys.argv[1])
server.close()
PY
setsid sleep 60 &
session_pid=$!
track_player_pid "$session_pid"
RADIO_ATLAS_TEST_SOCAT_MODE=success-unlink \
RADIO_ATLAS_TEST_SOCKET="$runtime_dir/mpv.sock" \
PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-player" stop | jq -e '.running == false' >/dev/null
wait "$session_pid" 2>/dev/null || true
session_pid=""
[[ ! -S $runtime_dir/mpv.sock ]]
[[ ! -e $runtime_dir/player.pid ]]

sleep 60 &
orphan_pid=$!
track_player_pid "$orphan_pid"
"$project_dir/radio-player" stop | jq -e '.running == false' >/dev/null
wait "$orphan_pid" 2>/dev/null || true
if kill -0 "$orphan_pid" 2>/dev/null; then
  echo "Tracked player without a socket was left running" >&2
  exit 1
fi
[[ ! -e $runtime_dir/player.pid ]]

session_child_file="$test_root/session-child.pid"
setsid "$project_dir/radio-session" bash --noprofile --norc -c \
  'printf "%s\n" "$$" > "$1"; exec sleep 60' radio-atlas-test "$session_child_file" \
  > "$test_root/session.log" 2>&1 &
session_pid=$!
for _ in $(seq 1 100); do
  [[ -s $session_child_file && -S $runtime_dir/proxy.sock ]] && break
  sleep 0.02
done
if [[ ! -s $session_child_file || ! -S $runtime_dir/proxy.sock ]]; then
  echo "Sandbox session did not start" >&2
  exit 1
fi
session_child_pid=$(<"$session_child_file")
track_player_pid "$session_pid"
"$project_dir/radio-player" stop | jq -e '.running == false' >/dev/null
wait "$session_pid" 2>/dev/null || true
session_pid=""
for _ in $(seq 1 50); do
  kill -0 "$session_child_pid" 2>/dev/null || break
  sleep 0.02
done
if kill -0 "$session_child_pid" 2>/dev/null; then
  echo "Sandbox child survived player termination" >&2
  exit 1
fi
[[ ! -S $runtime_dir/proxy.sock ]]

setsid "$project_dir/radio-session" sleep 60 > "$test_root/killed-session.log" 2>&1 &
session_pid=$!
for _ in $(seq 1 100); do
  [[ -S $runtime_dir/proxy.sock ]] && break
  sleep 0.02
done
[[ -S $runtime_dir/proxy.sock ]]
orphan_proxy_pid=$(pgrep -P "$session_pid" -f 'radio-proxy' | head -n 1)
[[ -n $orphan_proxy_pid ]]
orphan_bridge_pid=""
for _ in $(seq 1 100); do
  orphan_bridge_pid=$(pgrep -f \
    "^socat TCP4-LISTEN:18765,bind=127.0.0.1,reuseaddr,fork,max-children=32 UNIX-CONNECT:$runtime_dir/proxy.sock$" \
    | head -n 1 || true)
  [[ -n $orphan_bridge_pid ]] && break
  sleep 0.02
done
[[ -n $orphan_bridge_pid ]]
kill -KILL "$session_pid"
wait "$session_pid" 2>/dev/null || true
session_pid=""
for _ in $(seq 1 100); do
  if ! kill -0 "$orphan_proxy_pid" 2>/dev/null \
      && ! kill -0 "$orphan_bridge_pid" 2>/dev/null; then
    break
  fi
  sleep 0.02
done
if kill -0 "$orphan_proxy_pid" 2>/dev/null; then
  echo "Proxy survived an uncatchable session exit" >&2
  exit 1
fi
if kill -0 "$orphan_bridge_pid" 2>/dev/null; then
  echo "Sandbox bridge survived an uncatchable session exit" >&2
  exit 1
fi
[[ ! -S $runtime_dir/proxy.sock ]]

for _ in $(seq 1 30); do
  printf '{"favorites":[],"recent":[],"volume":70}\n' \
    > "$XDG_DATA_HOME/radio-atlas/state.json"
  "$project_dir/radio-state" favorite 12345678-1234-1234-1234-123456789abc >/dev/null &
  favorite_pid=$!
  "$project_dir/radio-player" volume 43 >/dev/null &
  volume_pid=$!
  wait "$favorite_pid"
  wait "$volume_pid"
  jq -e '.volume == 43 and (.favorites | length == 1)' \
    "$XDG_DATA_HOME/radio-atlas/state.json" >/dev/null
done

track_player_pid "$$"
if PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-player" play 12345678-1234-1234-1234-123456789abc results \
  >/dev/null 2>&1; then
  echo "A second player was started while a tracked player was alive" >&2
  exit 1
fi
rm "$runtime_dir/player.pid"

mpv_marker="$test_root/mpv-started"
if RADIO_ATLAS_TEST_MPV_MARKER="$mpv_marker" PATH="$project_dir/tests/fixtures:$PATH" \
  "$project_dir/radio-player" play 12345678-1234-1234-1234-123456789abc world \
  >/dev/null 2>&1; then
  echo "Player startup failure was reported as success" >&2
  exit 1
fi
if [[ ! -e $mpv_marker ]]; then
  echo "Player fixture did not start inside the sandbox" >&2
  exit 1
fi

unsafe='[{"uuid":"abcdefab-1234-1234-1234-abcdefabcdef","name":"Unsafe","url":"file:///etc/passwd"}]'
printf '%s\n' "$unsafe" > "$runtime_dir/results.json"
if "$project_dir/radio-player" play abcdefab-1234-1234-1234-abcdefabcdef results \
  >/dev/null 2>&1; then
  echo "Unsafe stream URL was accepted" >&2
  exit 1
fi

echo "All tests passed"
