#!/usr/bin/env bash
set -euo pipefail

runtime_root=${XDG_RUNTIME_DIR:-/tmp}
runtime_dir="$runtime_root/omarchy-radio-atlas-$UID"
mkdir -p "$runtime_dir"

world_file="$runtime_dir/world.json"
results_file="$runtime_dir/results.json"
user_agent='Radio Atlas/0.1 (https://github.com/AksharP5/omarchy-radio-atlas)'
bases=(
  'https://all.api.radio-browser.info'
  'https://de1.api.radio-browser.info'
  'https://nl1.api.radio-browser.info'
)

normalize='def number_or_null: try tonumber catch null;
  map({
    uuid: (.stationuuid // ""),
    name: ((.name // "Unknown station") | gsub("[\\r\\n\\t]"; " ") | gsub("  +"; " ")),
    url: (.url_resolved // .url // ""),
    homepage: (.homepage // ""),
    favicon: (.favicon // ""),
    country: (.country // ""),
    countryCode: ((.countrycode // "") | ascii_upcase),
    state: (.state // ""),
    language: (.language // ""),
    tags: (.tags // ""),
    codec: (.codec // ""),
    bitrate: ((.bitrate // 0) | number_or_null // 0),
    votes: ((.votes // 0) | number_or_null // 0),
    clicks: ((.clickcount // 0) | number_or_null // 0),
    latitude: ((.geo_lat // null) | number_or_null),
    longitude: ((.geo_long // null) | number_or_null)
  })
  | map(select(.uuid != "" and .url != ""))
  | unique_by(.uuid)'

request() {
  local path=$1
  shift
  local base
  for base in "${bases[@]}"; do
    if curl --fail --silent --show-error --location \
      --connect-timeout 4 --max-time 12 --retry 1 \
      --user-agent "$user_agent" --get "$base$path" "$@"; then
      return 0
    fi
  done
  return 1
}

store_results() {
  local target=$1
  local temporary
  temporary=$(mktemp "$runtime_dir/results.XXXXXX")
  jq -c "$normalize" > "$temporary"
  mv "$temporary" "$target"
  if [[ $target != "$results_file" ]]; then
    cp "$target" "$results_file"
  fi
  cat "$target"
}

fetch_world() {
  if [[ -s $world_file ]] \
    && jq -e 'type == "array" and length > 0' "$world_file" >/dev/null 2>&1 \
    && find "$world_file" -mmin -30 -print -quit | grep -q .; then
    cp "$world_file" "$results_file"
    cat "$world_file"
    return
  fi

  request '/json/stations/search' \
    --data-urlencode 'has_geo_info=true' \
    --data-urlencode 'hidebroken=true' \
    --data-urlencode 'order=clickcount' \
    --data-urlencode 'reverse=true' \
    --data-urlencode 'limit=500' \
    | store_results "$world_file"
}

fetch_search() {
  local query=$1
  local search_dir
  search_dir=$(mktemp -d "$runtime_dir/search.XXXXXX")

  request '/json/stations/search' \
    --data-urlencode "name=$query" \
    --data-urlencode 'hidebroken=true' \
    --data-urlencode 'order=clickcount' \
    --data-urlencode 'reverse=true' \
    --data-urlencode 'limit=80' > "$search_dir/name.json" &
  local name_pid=$!

  request '/json/stations/search' \
    --data-urlencode "country=$query" \
    --data-urlencode 'hidebroken=true' \
    --data-urlencode 'order=clickcount' \
    --data-urlencode 'reverse=true' \
    --data-urlencode 'limit=80' > "$search_dir/country.json" &
  local country_pid=$!

  request '/json/stations/search' \
    --data-urlencode "tag=$query" \
    --data-urlencode 'hidebroken=true' \
    --data-urlencode 'order=clickcount' \
    --data-urlencode 'reverse=true' \
    --data-urlencode 'limit=80' > "$search_dir/tag.json" &
  local tag_pid=$!

  wait "$name_pid" || printf '[]' > "$search_dir/name.json"
  wait "$country_pid" || printf '[]' > "$search_dir/country.json"
  wait "$tag_pid" || printf '[]' > "$search_dir/tag.json"

  jq -s 'add' "$search_dir/name.json" "$search_dir/country.json" "$search_dir/tag.json" \
    | store_results "$results_file"
  rm -rf "$search_dir"
}

action=${1:-world}
case "$action" in
  world)
    fetch_world
    ;;
  country)
    code=${2:-}
    [[ $code =~ ^[A-Za-z]{2}$ ]] || { echo 'Country code must contain two letters' >&2; exit 2; }
    request '/json/stations/search' \
      --data-urlencode "countrycode=${code^^}" \
      --data-urlencode 'hidebroken=true' \
      --data-urlencode 'order=clickcount' \
      --data-urlencode 'reverse=true' \
      --data-urlencode 'limit=150' \
      | store_results "$results_file"
    ;;
  search)
    query=${2:-}
    [[ -n ${query//[[:space:]]/} ]] || { echo 'Search text is empty' >&2; exit 2; }
    fetch_search "$query"
    ;;
  random)
    request '/json/stations/search' \
      --data-urlencode 'has_geo_info=true' \
      --data-urlencode 'hidebroken=true' \
      --data-urlencode 'order=random' \
      --data-urlencode 'limit=60' \
      | store_results "$results_file"
    ;;
  *)
    echo "Unknown action: $action" >&2
    exit 2
    ;;
esac
