#!/usr/bin/env bash
set -euo pipefail
umask 077

: "${XDG_RUNTIME_DIR:?Radio Atlas requires XDG_RUNTIME_DIR}"
runtime_dir="$XDG_RUNTIME_DIR/omarchy-radio-atlas"
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}
cache_dir="$cache_root/omarchy-radio-atlas"
install -d -m 700 "$runtime_dir" "$cache_dir"

world_file="$runtime_dir/world.json"
world_cache_file="$cache_dir/world.json"
results_file="$runtime_dir/results.json"
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
state_path="$script_dir/radio-state"
version=$(jq -r '.version' "$script_dir/manifest.json")
user_agent="Radio Atlas/$version (https://github.com/AksharP5/omarchy-radio-atlas)"
max_response_bytes=4194304
world_cache_minutes=1440
search_dir=""

cleanup() {
  [[ -z $search_dir ]] || rm -rf "$search_dir"
}
trap cleanup EXIT

discover_bases() {
  local ip hostname
  while read -r ip; do
    hostname=$(getent hosts "$ip" 2>/dev/null | awk 'NR == 1 { print $2 }')
    if [[ $hostname =~ ^[A-Za-z0-9.-]+\.api\.radio-browser\.info$ ]]; then
      printf 'https://%s\n' "$hostname"
    fi
  done < <(getent ahostsv4 all.api.radio-browser.info 2>/dev/null \
    | awk '!seen[$1]++ { print $1 }')

}

mapfile -t bases < <(discover_bases | awk '!seen[$0]++' | shuf)
if (( ${#bases[@]} == 0 )); then
  bases=('https://all.api.radio-browser.info')
fi

normalize='def number_or_null: try tonumber catch null;
  def clean($limit):
    if type == "string"
    then gsub("[\\r\\n\\t]"; " ") | gsub("  +"; " ") | .[0:$limit]
    else ""
    end;
  def compact($limit):
    if type == "string" then gsub("[\\r\\n\\t]"; "") | .[0:$limit] else "" end;
  .[:500]
  | map({
    uuid: ((.stationuuid // "") | compact(64)),
    name: (((.name // "Unknown station") | clean(160)) as $name
      | if $name == "" then "Unknown station" else $name end),
    url: ((.url_resolved // .url // "") | compact(2048)),
    homepage: ((.homepage // "") | compact(2048)),
    favicon: ((.favicon // "") | compact(2048)),
    country: ((.country // "") | clean(100)),
    countryCode: ((.countrycode // "") | clean(2) | ascii_upcase),
    state: ((.state // "") | clean(100)),
    language: ((.language // "") | clean(120)),
    tags: ((.tags // "") | clean(500)),
    codec: ((.codec // "") | clean(32)),
    bitrate: ((.bitrate // 0) | number_or_null // 0),
    votes: ((.votes // 0) | number_or_null // 0),
    clicks: ((.clickcount // 0) | number_or_null // 0),
    latitude: ((.geo_lat // null) | number_or_null),
    longitude: ((.geo_long // null) | number_or_null)
  })
  | map(select(
      .uuid != ""
      and (.url | test("^https?://"; "i"))
      and (.latitude == null or (.latitude >= -90 and .latitude <= 90))
      and (.longitude == null or (.longitude >= -180 and .longitude <= 180))
    ))
  | reduce .[] as $station ({seen: {}, rows: []};
      if .seen[$station.uuid] then .
      else .seen[$station.uuid] = true | .rows += [$station]
      end)
  | .rows[:500]'

request() {
  local max_records=$1
  local path=$2
  shift 2
  local base error_file max_time response_file
  max_time=12
  (( max_records >= 500 )) && max_time=45
  error_file=$(mktemp "$runtime_dir/request.XXXXXX")
  response_file=$(mktemp "$runtime_dir/response.XXXXXX")
  for base in "${bases[@]}"; do
    if curl --fail --silent --show-error \
      --connect-timeout 4 --max-time "$max_time" \
      --max-filesize "$max_response_bytes" --proto '=https' \
      --user-agent "$user_agent" --get "$base$path" "$@" \
      --output "$response_file" 2>"$error_file" \
      && (( $(stat -c '%s' -- "$response_file") <= max_response_bytes )) \
      && jq -e -s --argjson maxRecords "$max_records" \
        'length == 1 and (.[0] | type == "array" and length <= $maxRecords)' \
        "$response_file" >/dev/null 2>&1; then
      cat "$response_file"
      rm -f "$error_file" "$response_file"
      return 0
    fi
    if [[ ! -s $error_file ]]; then
      printf 'Radio Browser returned invalid station data from %s\n' "$base" > "$error_file"
    fi
  done
  cat "$error_file" >&2
  rm -f "$error_file" "$response_file"
  return 1
}

publish_copy() {
  local source=$1
  local target=$2
  local temporary
  temporary=$(mktemp "${target%/*}/publish.XXXXXX")
  cp "$source" "$temporary"
  mv "$temporary" "$target"
}

valid_world_data() {
  local path=$1
  [[ -s $path ]] \
    && (( $(stat -c '%s' -- "$path") <= max_response_bytes )) \
    && jq -e -s 'length == 1 and (.[0]
      | type == "array" and length > 0 and length <= 500)' \
      "$path" >/dev/null 2>&1
}

publish_world_cache() {
  publish_copy "$world_cache_file" "$world_file"
  publish_copy "$world_cache_file" "$results_file"
}

store_results() {
  local target=$1
  local temporary
  temporary=$(mktemp "${target%/*}/results.XXXXXX")
  if ! jq -ce "$normalize" > "$temporary"; then
    rm -f "$temporary"
    return 1
  fi
  mv "$temporary" "$target"
  cat "$target"
}

store_random_results() {
  local target=$1
  local exclusions=${2:-}
  local temporary
  store_results "$target" >/dev/null
  temporary=$(mktemp "$runtime_dir/random.XXXXXX")
  jq -c --arg exclusions "$exclusions" '
    ($exclusions | split(",") | map(select(length > 0))
      | map({key: ., value: true}) | from_entries) as $excluded
    | (map(select($excluded[.uuid] != true))) as $fresh
    | if ($fresh | length) > 0 then $fresh[] else .[] end
  ' "$target" | shuf | jq -sc . > "$temporary"
  mv "$temporary" "$target"
  cat "$target"
}

refresh_world_cache() {
  request 500 '/json/stations/search' \
    --data-urlencode 'has_geo_info=true' \
    --data-urlencode 'hidebroken=true' \
    --data-urlencode 'order=clickcount' \
    --data-urlencode 'reverse=true' \
    --data-urlencode 'limit=500' \
    | store_results "$world_cache_file" >/dev/null
}

refresh_world_cache_in_background() {
  (
    exec 9>"$cache_dir/world.lock"
    flock -n 9 || exit 0
    refresh_world_cache
  ) </dev/null >/dev/null 2>&1 &
}

fetch_world() {
  local cache_valid=0
  if valid_world_data "$world_cache_file"; then
    cache_valid=1
  elif valid_world_data "$world_file"; then
    publish_copy "$world_file" "$world_cache_file"
    cache_valid=1
  fi

  if (( cache_valid )); then
    publish_world_cache
    cat "$world_cache_file"
    if ! find "$world_cache_file" -mmin "-$world_cache_minutes" \
      -print -quit | grep -q .; then
      refresh_world_cache_in_background
    fi
    return
  fi

  refresh_world_cache
  publish_world_cache
  cat "$world_cache_file"
}

fetch_search() {
  local query=$1
  search_dir=$(mktemp -d "$runtime_dir/search.XXXXXX")

  request 80 '/json/stations/search' \
    --data-urlencode "name=$query" \
    --data-urlencode 'hidebroken=true' \
    --data-urlencode 'order=clickcount' \
    --data-urlencode 'reverse=true' \
    --data-urlencode 'limit=80' > "$search_dir/name.json" &
  local name_pid=$!

  request 80 '/json/stations/search' \
    --data-urlencode "country=$query" \
    --data-urlencode 'hidebroken=true' \
    --data-urlencode 'order=clickcount' \
    --data-urlencode 'reverse=true' \
    --data-urlencode 'limit=80' > "$search_dir/country.json" &
  local country_pid=$!

  request 80 '/json/stations/search' \
    --data-urlencode "tag=$query" \
    --data-urlencode 'hidebroken=true' \
    --data-urlencode 'order=clickcount' \
    --data-urlencode 'reverse=true' \
    --data-urlencode 'limit=80' > "$search_dir/tag.json" &
  local tag_pid=$!

  local successful=0
  if wait "$name_pid"; then
    successful=$((successful + 1))
  else
    printf '[]' > "$search_dir/name.json"
  fi
  if wait "$country_pid"; then
    successful=$((successful + 1))
  else
    printf '[]' > "$search_dir/country.json"
  fi
  if wait "$tag_pid"; then
    successful=$((successful + 1))
  else
    printf '[]' > "$search_dir/tag.json"
  fi

  if (( successful == 0 )); then
    rm -rf "$search_dir"
    echo 'Station service is unavailable' >&2
    return 1
  fi

  jq -s 'add' "$search_dir/name.json" "$search_dir/country.json" "$search_dir/tag.json" \
    | store_results "$results_file"
  rm -rf "$search_dir"
  search_dir=""
}

resolve_stations() {
  local uuids=$1
  [[ $uuids =~ ^[0-9A-Fa-f-]{20,}(,[0-9A-Fa-f-]{20,})*$ ]] \
    || { echo 'Invalid station ids' >&2; exit 2; }
  (( ${#uuids} <= 4096 )) || { echo 'Too many station ids' >&2; exit 2; }

  local commas=${uuids//[^,]/}
  request "$(( ${#commas} + 1 ))" '/json/stations/byuuid' \
    --data-urlencode "uuids=$uuids" \
    | jq -c "$normalize"
}

action=${1:-world}
case "$action" in
  world)
    fetch_world
    ;;
  country)
    code=${2:-}
    [[ $code =~ ^[A-Za-z]{2}$ ]] || { echo 'Country code must contain two letters' >&2; exit 2; }
    request 150 '/json/stations/search' \
      --data-urlencode "countrycode=${code^^}" \
      --data-urlencode 'hidebroken=true' \
      --data-urlencode 'order=clickcount' \
      --data-urlencode 'reverse=true' \
      --data-urlencode 'limit=150' \
      | store_results "$results_file"
    ;;
  search)
    query=${2:-}
    [[ -n ${query//[[:space:]]/} ]] || { echo 'Search text is empty' >&2; exit 2; }
    (( ${#query} <= 128 )) || { echo 'Search text is too long' >&2; exit 2; }
    fetch_search "$query"
    ;;
  random)
    exclusions=${2:-}
    if [[ -n $exclusions ]]; then
      [[ $exclusions =~ ^[0-9A-Fa-f-]{20,64}(,[0-9A-Fa-f-]{20,64})*$ ]] \
        || { echo 'Invalid excluded station ids' >&2; exit 2; }
      (( ${#exclusions} <= 4096 )) || { echo 'Too many excluded station ids' >&2; exit 2; }
    fi
    saved_exclusions=$("$state_path" get 2>/dev/null | jq -r '
      [.recent[]?.uuid
        | select(type == "string" and length >= 20 and length <= 64)
        | select(test("^[0-9A-Fa-f-]+$"))][:30]
      | join(",")
    ' 2>/dev/null || true)
    exclusions=$(jq -nr --arg requested "$exclusions" --arg saved "$saved_exclusions" '
      [$requested, $saved] | map(split(",")) | add
      | map(select(length > 0)) | unique | join(",")
    ')
    (( ${#exclusions} <= 4096 )) || { echo 'Too many excluded station ids' >&2; exit 2; }
    request 60 '/json/stations/search' \
      --data-urlencode 'has_geo_info=true' \
      --data-urlencode 'hidebroken=true' \
      --data-urlencode 'order=random' \
      --data-urlencode 'limit=60' \
      | store_random_results "$results_file" "$exclusions"
    ;;
  resolve)
    resolve_stations "${2:-}"
    ;;
  *)
    echo "Unknown action: $action" >&2
    exit 2
    ;;
esac
