#!/usr/bin/env bash
set -euo pipefail
umask 077

: "${XDG_RUNTIME_DIR:?Radio Atlas requires XDG_RUNTIME_DIR}"
runtime_dir="$XDG_RUNTIME_DIR/omarchy-radio-atlas"
data_root=${XDG_DATA_HOME:-$HOME/.local/share}
state_dir="$data_root/radio-atlas"
state_file="$state_dir/state.json"
state_lock="$state_dir/state.lock"
install -d -m 700 "$runtime_dir" "$state_dir"

exec 9>"$state_lock"
flock -x 9

ensure_state() {
  if [[ ! -e $state_file ]]; then
    printf '{"favorites":[],"recent":[],"volume":70}\n' > "$state_file"
    return
  fi
  if [[ -s $state_file ]] && jq -e '
    type == "object"
    and (.favorites | type == "array")
    and (.recent | type == "array")
    and ((.volume // 70) | type == "number")
    and ((.volume // 70) >= 0 and (.volume // 70) <= 100)
  ' "$state_file" >/dev/null 2>&1; then
    return
  fi
  echo "Radio Atlas saved state is invalid; refusing to overwrite $state_file" >&2
  exit 4
}

ensure_runtime_data() {
  [[ -f $runtime_dir/results.json ]] || printf '[]\n' > "$runtime_dir/results.json"
  [[ -f $runtime_dir/world.json ]] || printf '[]\n' > "$runtime_dir/world.json"
  [[ -f $runtime_dir/playlist.json ]] || printf '[]\n' > "$runtime_dir/playlist.json"
}

find_station() {
  local uuid=$1
  jq -cs --arg uuid "$uuid" '
    (.[0] // []) + (.[1] // []) + (.[2] // [])
      + ((.[3] // {}).favorites // []) + ((.[3] // {}).recent // [])
    | map(select(.uuid == $uuid))
    | first // empty
  ' "$runtime_dir/playlist.json" "$runtime_dir/results.json" \
    "$runtime_dir/world.json" "$state_file" 2>/dev/null
}

write_state() {
  local filter=$1
  local station=$2
  local temporary
  temporary=$(mktemp "$state_dir/state.XXXXXX")
  jq -c --argjson station "$station" "$filter" "$state_file" > "$temporary"
  mv "$temporary" "$state_file"
}

write_volume() {
  local volume=$1
  local temporary
  temporary=$(mktemp "$state_dir/state.XXXXXX")
  jq -c --argjson volume "$volume" '.volume = $volume' "$state_file" > "$temporary"
  mv "$temporary" "$state_file"
}

ensure_state
ensure_runtime_data
action=${1:-get}
case "$action" in
  get)
    ;;
  favorite)
    uuid=${2:-}
    [[ $uuid =~ ^[0-9A-Fa-f-]{20,}$ ]] || { echo 'Invalid station id' >&2; exit 2; }
    station=$(find_station "$uuid")
    [[ -n $station ]] || { echo 'Station is not in the current data set' >&2; exit 3; }
    write_state '
      if any(.favorites[]?; .uuid == $station.uuid)
      then .favorites = [.favorites[] | select(.uuid != $station.uuid)]
      else .favorites = [$station] + [.favorites[] | select(.uuid != $station.uuid)]
      end
    ' "$station"
    ;;
  played)
    uuid=${2:-}
    [[ $uuid =~ ^[0-9A-Fa-f-]{20,}$ ]] || { echo 'Invalid station id' >&2; exit 2; }
    station=$(find_station "$uuid")
    [[ -n $station ]] || { echo 'Station is not in the current data set' >&2; exit 3; }
    write_state '.recent = ([$station] + [.recent[] | select(.uuid != $station.uuid)])[:30]' "$station"
    ;;
  volume)
    volume=${2:-}
    [[ $volume =~ ^[0-9]+$ ]] \
      || { echo 'Volume must be an integer from 0 to 100' >&2; exit 2; }
    (( volume >= 0 && volume <= 100 )) \
      || { echo 'Volume must be an integer from 0 to 100' >&2; exit 2; }
    write_volume "$volume"
    ;;
  *)
    echo "Unknown action: $action" >&2
    exit 2
    ;;
esac

jq -c . "$state_file"
