#!/usr/bin/env python3
"""Read Wayland clipboard text without blocking or growing the shell."""

import argparse
import os
import selectors
import signal
import subprocess
import sys
import time

MAX_BYTES = 4096
TIMEOUT_SECONDS = 2


def read_clipboard(primary=False):
    command = ["setpriv", "--pdeathsig", "KILL", "wl-paste", "--no-newline", "--type", "text"]
    if primary:
        command.append("--primary")
    process = subprocess.Popen(command, stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               start_new_session=True)
    try:
        output = bytearray()
        deadline = time.monotonic() + TIMEOUT_SECONDS
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ)
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0 or not selector.select(remaining):
                    raise TimeoutError("clipboard transfer timed out")
                chunk = os.read(process.stdout.fileno(), MAX_BYTES + 1 - len(output))
                if not chunk:
                    break
                output.extend(chunk)
                if len(output) > MAX_BYTES:
                    raise ValueError("clipboard text exceeds 4096 bytes")
        process.wait(timeout=max(0.001, deadline - time.monotonic()))
        if process.returncode:
            raise ValueError("clipboard text is unavailable")
        return output.decode("utf-8")
    finally:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()
        process.stdout.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--primary", action="store_true")
    args = parser.parse_args()
    for stop_signal in (signal.SIGTERM, signal.SIGINT):
        signal.signal(stop_signal, lambda signum, _: sys.exit(128 + signum))
    try:
        value = read_clipboard(args.primary)
    except (OSError, ValueError, TimeoutError, subprocess.SubprocessError) as error:
        print(f"radio-clipboard: {error}", file=sys.stderr)
        return 1
    sys.stdout.write(value)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
